function setupProject() {
  return withLock_(function(){
    var spreadsheet=spreadsheet_();Object.keys(APP.TABLES).forEach(function(name){var headers=APP.TABLES[name],sheet=spreadsheet.getSheetByName(name);if(!sheet)sheet=spreadsheet.insertSheet(name);if(sheet.getLastRow()===0){sheet.getRange(1,1,1,headers.length).setValues([headers]);sheet.setFrozenRows(1);}else{var actual=sheet.getRange(1,1,1,headers.length).getValues()[0];if(JSON.stringify(actual)!==JSON.stringify(headers))throw appError_('SCHEMA','Header sheet '+name+' tidak sesuai schema.');}});
    upsertMeta_('schemaVersion',APP.SCHEMA_VERSION);upsertSetting_('PORTAL_MODE','LOGIN_REQUIRED','SETUP');seedCategoriesAndFields_();SpreadsheetApp.flush();return {ok:true,schemaVersion:APP.SCHEMA_VERSION};
  });
}
function upsertMeta_(key,value){var row=findOne_('META',function(item){return item.key===key;}),next={key:key,value:value,updatedAt:nowIso_()};if(row)replaceRow_('META',row._row,next);else append_('META',next);}
function upsertSetting_(key,value,actor){var row=findOne_('SETTINGS',function(item){return item.key===key;}),next={key:key,value:value,updatedAt:nowIso_(),updatedBy:actor};if(row)replaceRow_('SETTINGS',row._row,next);else append_('SETTINGS',next);}
function seedCategoriesAndFields_(){
  INITIAL_CATEGORIES.forEach(function(seed){var category=findOne_('CATEGORIES',function(row){return row.code===seed.code&&!row.deletedAt;});if(!category){var now=nowIso_();category={id:uuid_(),code:seed.code,name:seed.name,description:seed.description,active:true,sortOrder:seed.sortOrder,version:1,createdAt:now,createdBy:'SETUP',updatedAt:now,updatedBy:'SETUP',deletedAt:'',deletedBy:''};append_('CATEGORIES',category);}var fields=INITIAL_FIELDS[seed.code]||[];fields.forEach(function(field,index){if(!findOne_('FIELDS',function(row){return row.categoryId===category.id&&row.key===field[0]&&!row.deletedAt;})){var visible=['name','position','cpnsRank','addressCity'].indexOf(field[0])!==-1,now=nowIso_();append_('FIELDS',{id:uuid_(),categoryId:category.id,key:field[0],label:field[1],type:field[2],required:field[0]==='name',optionsJson:'[]',tableVisible:visible,publicVisible:true,portalVisible:true,adminVisible:true,sortOrder:index+1,active:true,system:true,version:1,createdAt:now,createdBy:'SETUP',updatedAt:now,updatedBy:'SETUP',deletedAt:'',deletedBy:''});}});});
}
function configureProject(spreadsheetId,driveFolderId,hmacSecret,bootstrapSecret){if(!spreadsheetId||!driveFolderId||String(hmacSecret).length<32||String(bootstrapSecret).length<24)throw new Error('Konfigurasi tidak lengkap atau secret terlalu pendek.');props_().setProperties({SPREADSHEET_ID:spreadsheetId,DRIVE_FOLDER_ID:driveFolderId,HMAC_SECRET:hmacSecret,BOOTSTRAP_SECRET:bootstrapSecret},false);return setupProject();}
