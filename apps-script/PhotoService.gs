  var folderId=props_().getProperty(APP.PROPERTY_KEYS.DRIVE_FOLDER_ID);if(!folderId)throw appError_('CONFIGURATION','DRIVE_FOLDER_ID belum dikonfigurasi.');var blob=Utilities.newBlob(bytes,mime,requireText_(payload.name,'Nama file',1,150)),file;
  try{file=DriveApp.getFolderById(folderId).createFile(blob);var metadata={id:uuid_(),employeeId:String(payload.employeeId||''),driveFileId:file.getId(),name:file.getName(),mimeType:mime,size:bytes.length,checksum:sha256_(Utilities.base64Encode(bytes)),state:'ACTIVE',createdAt:nowIso_(),createdBy:actor.accountId,deletedAt:'',deletedBy:''};append_('FILES',metadata);audit_(actor,'files.upload','FILE',metadata.id,{employeeId:metadata.employeeId,mimeType:mime,size:bytes.length});return metadata;}catch(error){if(file)file.setTrashed(true);throw error;}
}
function photoVisibleToReader_(fileId,audience){
  var categoryIds=readerCategoryIds_(),photoCategories=activeRows_('FIELDS').filter(function(field){return field.type==='photo'&&fieldVisibleToAudience_(field,audience);}).map(function(field){return field.categoryId;});
