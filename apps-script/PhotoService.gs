function photoMagicValid_(bytes, mimeType) {
  if (mimeType === 'image/jpeg') return bytes.length > 3 && (bytes[0] & 255) === 255 && (bytes[1] & 255) === 216 && (bytes[2] & 255) === 255;
  if (mimeType === 'image/png') return bytes.length > 8 && (bytes[0] & 255) === 137 && String.fromCharCode(bytes[1]&255,bytes[2]&255,bytes[3]&255)==='PNG';
  if (mimeType === 'image/webp') return bytes.length > 12 && String.fromCharCode.apply(null, bytes.slice(0,4))==='RIFF' && String.fromCharCode.apply(null, bytes.slice(8,12))==='WEBP';
  return false;
}
