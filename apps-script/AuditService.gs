function auditValue_(value){if(value===undefined||value===null||value==='')return '';if(typeof value==='boolean'||typeof value==='number')return value;var text=typeof value==='object'?JSON.stringify(value):String(value);return text.length>500?text.slice(0,497)+'...':text;}
