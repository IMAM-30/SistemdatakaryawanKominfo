  append_('AUDIT_LOGS', { id: uuid_(), actorId: actor ? actor.accountId : 'SYSTEM', actorRole: actor ? actor.role : 'SYSTEM', action: action, entityType: entityType, entityId: entityId || '', summaryJson: JSON.stringify(cleanObject_(summary || {})), createdAt: nowIso_(), actorUsername:actor?(actor.username||(account&&account.username)||actor.accountId):'SYSTEM', actorDisplayName:actor?(actor.displayName||(account&&account.displayName)||''):'Sistem' });
